# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Privileged migration/admin connection. Use the Supabase session-mode pooler or
# direct connection for migrations; never use it for request queries.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
# Restricted runtime login (`lush_app`) used by API requests. It must be NOBYPASSRLS.
# APP_DATABASE_URL=postgresql://lush_app.PROJECT_REF:PASSWORD@HOST:6543/postgres
# Optional separate admin URL for migrations; defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=
# Production startup schema migrations are disabled by default; apply SQL as a
# release step. Set true only for local development if needed.
RUN_STARTUP_MIGRATIONS=false

# Local development / migration fallback values
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lush_laundry
DB_USER=postgres
DB_PASSWORD=your_password_here

# This backend deployment is pinned to one tenant. Keep 1 for Lush; set 2 only
# in the cloned Hommiez backend deployment. Client headers cannot change it.
DEPLOYMENT_TENANT_ID=1

# JWT Configuration
# Generate strong secret: openssl rand -base64 32
# REQUIRED in production — app will refuse the insecure default.
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Session Configuration
# Generate strong secret: openssl rand -base64 32
SESSION_SECRET=your_session_secret_min_32_chars_random_string

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Meta WhatsApp Webhook Verification
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token_here

# Email Configuration (for notifications)
# Use Gmail App Password: https://support.google.com/accounts/answer/185833
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
BACKUP_EMAIL_USER=
BACKUP_EMAIL_PASSWORD=

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Authorized Admin Emails (comma-separated)
AUTHORIZED_ADMIN_EMAILS=admin@yourdomain.com,admin2@yourdomain.com
SYSTEM_ADMIN_EMAILS=admin@yourdomain.com

# Seed / bootstrap account passwords (NEVER commit real values)
SEED_ADMIN_EMAIL=admin@lushlaundry.com
SEED_ADMIN_PASSWORD=change_me_admin_password
SEED_ADMIN_PHONE=+256700000000
SEED_USER_PASSWORD=change_me_user_password
SEED_MANAGER_EMAIL=manager@lushlaundry.com
SEED_MANAGER_PASSWORD=change_me_manager_password
SEED_AGENT_PASSWORD=change_me_agent_password
SEED_CASHIER_EMAIL=cashier@lushlaundry.com
SEED_CASHIER_PASSWORD=change_me_cashier_password

# WhatsApp Configuration (Twilio Business API — optional)
# Day-to-day staff messaging uses WhatsApp Messenger via wa.me in the UI
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# SMS Configuration (Africa's Talking)
SMS_ENABLED=false
AFRICASTALKING_API_KEY=your_api_key_here
AFRICASTALKING_USERNAME=your_username_here
AFRICASTALKING_WA_NUMBER=+254799999999
SMS_SENDER_ID=LUSHLAUNDRY
BUSINESS_HOURS=Mon-Sat: 7:00 AM - 9:00 PM

# Keep secrets only in .env — never in source code or git

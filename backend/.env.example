# Hommiez backend local environment template. Copy to .env and enter private values there.
PORT=5000
NODE_ENV=development

# Restricted Supabase runtime connection. Keep the password URL-encoded.
APP_DATABASE_URL=postgresql://runtime_user:URL_ENCODED_PASSWORD@your-pooler-host:6543/postgres
DEPLOYMENT_TENANT_ID=2
DEFAULT_TENANT_ID=2
RUN_STARTUP_MIGRATIONS=false

# Generate a unique random secret for this deployment.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Local frontend origin. In Render, set this to the deployed Hommiez Vercel URL.
FRONTEND_URL=http://localhost:8080
SYSTEM_ADMIN_EMAILS=admin@example.com

# Optional: only needed when email backup delivery is enabled.
RESEND_API_KEY=

# One-time setup-admin script values. Do not add the password to Render.
SETUP_ADMIN_TENANT_ID=2
SETUP_ADMIN_EMAIL=admin@example.com
SETUP_ADMIN_FULL_NAME=Hommiez System Administrator
SETUP_ADMIN_PHONE=+256700000000
SETUP_ADMIN_PASSWORD=replace_with_a_strong_unique_password

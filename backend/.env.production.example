# Backend Production Environment Variables
# Copy this to .env on your production server and update with actual values

# CRITICAL: Change NODE_ENV to production
NODE_ENV=production

# Server Configuration
PORT=5000

# Database Configuration - Supabase (Production)
# Get credentials from: https://supabase.com/dashboard/project/xrkptygpwjdizvhkgvpo/settings/database
# Prefer Transaction Pooler for IPv4/free-tier compatibility.
# Example: postgresql://<user>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xrkptygpwjdizvhkgvpo:your_supabase_password_here@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.xrkptygpwjdizvhkgvpo
DB_PASSWORD=your_supabase_password_here

# JWT Configuration - GENERATE NEW SECRET FOR PRODUCTION
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_BASE64_32
JWT_EXPIRES_IN=7d

# Session Configuration - GENERATE NEW SECRET FOR PRODUCTION
# Generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# CORS Configuration - Netlify Frontend URL
FRONTEND_URL=https://laundrosys.netlify.app

# Google OAuth Configuration (Production)
# Update redirect URIs in Google Cloud Console:
# - https://lush-laundry-api.onrender.com/api/auth/google/callback
# - https://laundrosys.netlify.app
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret
GOOGLE_CALLBACK_URL=https://lush-laundry-api.onrender.com/api/auth/google/callback

# Authorized Admin Emails (comma-separated)
AUTHORIZED_ADMIN_EMAILS=husseinibram555@gmail.com

# Systems Administrators (comma-separated)
# Controls strict system-admin-only features in backend auth checks.
SYSTEM_ADMIN_EMAILS=husseinibram555@gmail.com

# Supabase Storage (required for persistent profile pictures)
# Use project URL and service role key from Supabase dashboard -> Settings -> API
SUPABASE_URL=https://xrkptygpwjdizvhkgvpo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=profile-pictures

# WhatsApp Configuration (Twilio) - Optional
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# SMS Configuration (Africa's Talking) - Optional
SMS_ENABLED=false
AFRICASTALKING_API_KEY=your_api_key_here
AFRICASTALKING_USERNAME=your_username_here
SMS_SENDER_ID=LUSHLAUNDRY
BUSINESS_HOURS=Mon-Sat: 7:00 AM - 9:00 PM

# Email Configuration (Gmail) - Optional
# For Gmail, generate an "App PaFor user notifications
# Get App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=husseinibram555@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
# SECURITY CHECKLIST BEFORE DEPLOYMENT:
# ✅ Change all secrets (JWT_SECRET, SESSION_SECRET)
# ✅ Use strong database password
# ✅ Update FRONTEND_URL to your production domain
# ✅ Update GOOGLE_CALLBACK_URL to production URL
# ✅ Add production URLs to Google Cloud Console redirect URIs
# ✅ Set NODE_ENV=production
# ✅ Update AUTHORIZED_ADMIN_EMAILS with real admin emails
# ✅ Never commit this .env file to git
